{
  "name": "@flutterwavebnw/checkout-cli",
  "version": "0.1.0",
  "description": "Command-line tooling for Flutterwave Checkout. Forwards real test-mode events to a handler on your own machine, so webhook code can be exercised against genuine signatures during development.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flw-beam/checkout-js.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/flw-beam/checkout-js/issues",
  "type": "module",
  "bin": {
    "flutterwavebnw-checkout": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@flutterwavebnw/checkout-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "20.16.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
