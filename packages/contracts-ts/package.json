{
  "name": "@flutterwavebnw/checkout-contracts",
  "version": "0.1.0",
  "description": "TypeScript bindings generated from /contracts (OpenAPI + AsyncAPI). The TS side of the one-core-many-surfaces seam.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flw-beam/checkout-js.git",
    "directory": "packages/contracts-ts"
  },
  "bugs": "https://github.com/flw-beam/checkout-js/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./openapi": {
      "types": "./dist/gen/rest.d.ts",
      "default": "./dist/gen/rest.js"
    },
    "./api-index": {
      "types": "./dist/gen/api-index.d.ts",
      "default": "./dist/gen/api-index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
